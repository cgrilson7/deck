{
  "name": "deck",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Seven Claude Code sessions in one window: one in focus on the left, the rest live in a grid on the right.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "smoke": "node scripts/smoke.mjs",
    "tmux": "tmux -L deck-dev",
    "dist": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.catalystdatascience.deck",
    "productName": "Deck",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**",
      "build/icon.png"
    ],
    "extraResources": [
      "tmux.conf"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.43.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.5.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
